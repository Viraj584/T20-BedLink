<p class="font-body-md text-body-md text-secondary-fixed-dim leading-snug">
        Dispatch will immediately reroute ambulance <span class="font-bold text-surface-bright">KA-01-2201</span> to <span class="text-secondary-fixed underline">Sunrise Heart</span> (8 min away).
      </p>
</div>
<!-- Selectable Options (Radio Cards) -->
<div aria-label="Rejection Reason" class="px-5 flex flex-col gap-3" id="reasonGroup" role="radiogroup">
<!-- Option 1: Selected State (No Bed Available) -->
<label class="reason-card group relative flex items-center justify-between p-4 min-h-[72px] rounded-[14px] bg-[#07262B] shadow-md cursor-pointer transition-all duration-150 ring-2 ring-error" data-index="1" id="card-1">
<div class="flex items-start gap-3.5 pr-2">
<!-- Custom Radio Glyph -->
<div class="radio-indicator mt-0.5 w-6 h-6 rounded-full flex items-center justify-center shrink-0 bg-error transition-colors">
<div class="w-2.5 h-2.5 rounded-full bg-surface-bright"></div>
</div>
<div class="flex flex-col">
<span class="font-title-lg text-title-lg text-surface-bright font-bold leading-tight">No bed available</span>
<span class="font-label-md text-label-md text-secondary-fixed-dim mt-0.5">All ICU beds currently occupied</span>
</div>
</div>
<span class="material-symbols-outlined text-error shrink-0 text-[22px]">hotel</span>
<input checked="" class="sr-only" name="reject_reason" type="radio" value="no_bed"/>
</label>
<!-- Option 2: Unselected State (Staff Busy) -->
<label class="reason-card group relative flex items-center justify-between p-4 min-h-[72px] rounded-[14px] bg-[#07262B] shadow-sm cursor-pointer transition-all duration-150 ring-1 ring-outline/30" data-index="2" id="card-2">
<div class="flex items-start gap-3.5 pr-2">
<div class="radio-indicator mt-0.5 w-6 h-6 rounded-full flex items-center justify-center shrink-0 bg-[#0F3A41] transition-colors">
<div class="radio-dot hidden w-2.5 h-2.5 rounded-full bg-surface-bright"></div>
</div>
<div class="flex flex-col">
<span class="font-title-lg text-title-lg text-surface-bright font-bold leading-tight">Staff busy</span>
<span class="font-label-md text-label-md text-secondary-fixed-dim mt-0.5">Trauma team engaged in active resuscitation</span>
</div>
</div>
<span class="material-symbols-outlined text-outline-variant shrink-0 text-[22px]">group_off</span>
<input class="sr-only" name="reject_reason" type="radio" value="staff_busy"/>
</label>
<!-- Option 3: Unselected State (Equipment Down) -->
<label class="reason-card group relative flex items-center justify-between p-4 min-h-[72px] rounded-[14px] bg-[#07262B] shadow-sm cursor-pointer transition-all duration-150 ring-1 ring-outline/30" data-index="3" id="card-3">
<div class="flex items-start gap-3.5 pr-2">
<div class="radio-indicator mt-0.5 w-6 h-6 rounded-full flex items-center justify-center shrink-0 bg-[#0F3A41] transition-colors">
<div class="radio-dot hidden w-2.5 h-2.5 rounded-full bg-surface-bright"></div>
</div>
<div class="flex flex-col">
<span class="font-title-lg text-title-lg text-surface-bright font-bold leading-tight">Equipment down</span>
<span class="font-label-md text-label-md text-secondary-fixed-dim mt-0.5">Ventilators undergoing urgent maintenance</span>
</div>
</div>
<span class="material-symbols-outlined text-outline-variant shrink-0 text-[22px]">medical_services</span>
<input class="sr-only" name="reject_reason" type="radio" value="equipment_down"/>
</label>
</div>
<!-- Handover Safety Note / Visual Reassurance -->
<div class="mx-5 mt-4 px-3 py-2.5 rounded-lg bg-[#07262B]/70 flex items-center gap-2.5">
<span class="material-symbols-outlined text-secondary-fixed text-[20px] shrink-0">alt_route</span>
<p class="font-label-md text-label-md text-secondary-fixed-dim">
        Sunrise Heart was notified and pre-allocated an unassigned Cath Lab bay.
      </p>
</div>
<!-- Interactive Sticky Bottom Action Bar -->
<div class="p-5 pt-4 flex flex-col gap-2.5">
<!-- High-Urgency Destructive Action -->
<button class="w-full h-16 min-h-[64px] bg-error active:bg-on-error-container text-surface-bright rounded-[14px] font-label-lg text-label-lg flex items-center justify-center gap-3 font-bold shadow-lg transition-transform active:scale-[0.98]" id="confirmRejectBtn" type="button">
<span class="material-symbols-outlined text-[24px]">close</span>
<span>Confirm Reject &amp; Reroute</span>
</button>
<!-- Dismiss / Revert Action -->
<button class="w-full h-14 min-h-[56px] rounded-[14px] bg-transparent text-secondary-fixed font-label-lg text-label-lg flex items-center justify-center gap-2 font-bold transition-colors active:bg-[#07262B]" id="backAlertBtn" type="button">
<span class="material-symbols-outlined text-[20px]">arrow_back</span>
<span>Back to Alert (Hold Request)</span>
</button>
</div>
<!-- Safe area anchor -->
<div class="h-2"></div>
</section>
</div>
<script>
  (function initRejectSheetInteractions() {
    const cards = document.querySelectorAll('.reason-card');
    
    cards.forEach(card => {
      card.addEventListener('click', () => {
        // Clear all selections
        cards.forEach(c => {
          c.classList.remove('ring-2', 'ring-error');
          c.classList.add('ring-1', 'ring-outline/30');
          
          const ind = c.querySelector('.radio-indicator');
          const dot = c.querySelector('.radio-dot');
          const icon = c.querySelector('.material-symbols-outlined:last-child');
          
          ind.classList.remove('bg-error');
          ind.classList.add('bg-[#0F3A41]');
          if (dot) dot.classList.add('hidden');
          
          if (icon) {
            icon.classList.remove('text-error');
            icon.classList.add('text-outline-variant');
          }
        });

        // Activate clicked card
        card.classList.remove('ring-1', 'ring-outline/30');
        card.classList.add('ring-2', 'ring-error');

        const activeInd = card.querySelector('.radio-indicator');
        const activeDot = card.querySelector('.radio-dot');
        const activeIcon = card.querySelector('.material-symbols-outlined:last-child');
        
        activeInd.classList.remove('bg-[#0F3A41]');
        activeInd.classList.add('bg-error');
        if (activeDot) activeDot.classList.remove('hidden');
        
        if (activeIcon) {
          activeIcon.classList.remove('text-outline-variant');
          activeIcon.classList.add('text-error');
        }

        const input = card.querySelector('input[type="radio"]');
        if (input) input.checked = true;
      });
    });

    const confirmBtn = document.getElementById('confirmRejectBtn');
    const backBtn = document.getElementById('backAlertBtn');

    if (confirmBtn) {
      confirmBtn.addEventListener('click', () => {
        confirmBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[24px]">progress_activity</span><span>Rerouting Emergency...</span>';
        confirmBtn.classList.add('opacity-90');
      });
    }

    if (backBtn) {
      backBtn.addEventListener('click', () => {
        backBtn.classList.add('opacity-50');
      });
    }
  })();
</script></main></body></html>
</file>

