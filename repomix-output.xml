        markerPath,
        JSON.stringify({
          _ts: Date.now(),
          source: 'session-restore-hook',
          enabled: { spinner: enableSpinner, announcements: enableAnnouncements },
        }, null, 2),
        { encoding: 'utf-8', mode: 0o600 }
      );
    } catch { /* ignore — best effort */ }

