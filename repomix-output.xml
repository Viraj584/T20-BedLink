<script>
  // Dynamic Real-time Countdown Simulation for Paramedic Display
  (() => {
    let remainingSeconds = 102; // 1:42
    const totalDuration = 120; // 2:00 window
    const circumference = 565.48; // 2 * PI * 90
    const ring = document.getElementById('countdown-ring');
    const text = document.getElementById('countdown-text');

    if (!ring || !text) return;

    const timer = setInterval(() => {
      if (remainingSeconds <= 0) {
        clearInterval(timer);
        text.innerText = "0:00";
        ring.style.strokeDashoffset = "0";
        return;
      }
      remainingSeconds--;
      const mins = Math.floor(remainingSeconds / 60);
      const secs = remainingSeconds % 60;
      text.innerText = `${mins}:${secs < 10 ? '0' : ''}${secs}`;

      // Update ring offset
      const progress = remainingSeconds / totalDuration;
      const offset = circumference * (1 - progress);
      ring.style.strokeDashoffset = offset.toFixed(2);
    }, 1000);
  })();
</script></main></body></html>
