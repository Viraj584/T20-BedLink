<button class="w-full h-[72px] bg-primary-container active:bg-[#0A5560] text-on-primary rounded-xl px-space-lg flex items-center justify-between shadow-md transition-all active:scale-[0.99] touch-manipulation" type="button">
<div class="flex items-center gap-space-sm text-left">
<div class="w-12 h-12 rounded-lg bg-white/20 flex items-center justify-center text-on-primary">
<span class="material-symbols-outlined text-[28px]">directions</span>
</div>
<div class="flex flex-col">
<span class="font-label-lg text-label-lg text-on-primary font-bold">Navigate to ER</span>
<span class="font-label-md text-label-md text-on-primary/80">Google Maps Navigation • 8 min</span>
</div>
</div>
<span class="material-symbols-outlined text-[28px] text-on-primary">arrow_forward</span>
</button>
