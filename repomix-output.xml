<button class="w-full h-14 bg-surface-container-low active:bg-surface-container-high text-primary-container rounded-xl px-space-md flex items-center justify-center gap-2 font-label-lg text-label-lg font-bold shadow-xs transition-colors touch-manipulation" type="button">
<span class="material-symbols-outlined text-[22px]" style="font-variation-settings: 'FILL' 1;">where_to_vote</span>
      Mark Arrived at Bay
    </button>
<!-- Tertiary Transfer Form Action -->
<div class="w-full flex justify-center pt-space-xs">
<button class="min-h-[44px] px-space-md py-space-xs text-primary font-label-md text-label-md font-bold flex items-center gap-1 active:opacity-75 transition-opacity" type="button">
<span>View Transfer Handover Form</span>
<span class="material-symbols-outlined text-[16px]">chevron_right</span>
</button>
</div>
</div>
</div>
<script>
  // Simple countdown timer for Bed Hold duration
  (function() {
    let totalSeconds = 14 * 60 + 48;
    const countdownEl = document.getElementById('countdown');
    if (!countdownEl) return;
    
    const interval = setInterval(() => {
      if (totalSeconds <= 0) {
        clearInterval(interval);
        countdownEl.innerText = "00:00";
        return;
      }
      totalSeconds--;
      const m = Math.floor(totalSeconds / 60);
      const s = totalSeconds % 60;
      countdownEl.innerText = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    }, 1000);
  })();
</script></main></body></html>
