</div>
</div>
<a class="mt-space-xs w-full flex items-center justify-between px-space-md py-2.5 rounded-lg bg-surface-container-lowest text-primary active:bg-surface-variant transition-colors min-h-[44px]" href="tel:402">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-[20px] text-primary">phone_in_talk</span>
<span class="font-label-md text-label-md text-on-surface">Direct Bay Intercom: <strong class="text-primary font-bold">Ext 402</strong></span>
</div>
<span class="font-label-md text-label-md text-primary underline font-bold">Tap to Call</span>
</a>
</div>
</div>
