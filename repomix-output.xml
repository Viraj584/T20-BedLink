<div class="flex items-center justify-between">
<div class="flex items-center gap-space-xs text-primary font-title-lg text-title-lg">
<span class="material-symbols-outlined text-[22px]">navigation</span>
<span>Route Summary</span>
</div>
<span class="inline-flex items-center gap-1 font-label-md text-label-md text-[#1E9E5A] bg-[#E3F5EB] px-2 py-0.5 rounded-full">
