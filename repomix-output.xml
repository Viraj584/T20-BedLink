<div class="flex items-center justify-between">
<span class="font-label-md text-label-md text-tertiary uppercase tracking-wider">Missed Handover Record</span>
<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-error-container text-on-error-container font-label-md text-[11px]">
        AUTO-TRANSFERRED
      </span>
</div>
<!-- Patient Condition Spec -->
<div class="flex items-start gap-space-sm bg-surface-container-lowest p-space-sm rounded-lg shadow-sm">
<div class="w-9 h-9 rounded-lg bg-surface-variant flex items-center justify-center text-primary-container flex-shrink-0">
<span class="material-symbols-outlined text-[20px]">personal_injury</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex items-center gap-2 flex-wrap">
<span class="font-title-lg text-title-lg text-on-surface">Patient: 58M</span>
<span class="inline-flex items-center px-1.5 py-0.5 rounded bg-error-container text-on-error-container font-label-md text-[11px] font-bold uppercase">
            Critical
          </span>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mt-0.5">Needed ICU + Ventilator</p>
</div>
</div>
<!-- Ambulance Transit Tag -->
<div class="flex items-center gap-space-sm bg-surface-container-lowest p-space-sm rounded-lg shadow-sm">
<div class="w-9 h-9 rounded-lg bg-secondary-container flex items-center justify-center text-on-secondary-container flex-shrink-0">
<span class="material-symbols-outlined text-[20px]">ambulance</span>
</div>
<div class="flex-1 min-w-0">
<span class="font-label-md text-label-md text-on-surface block truncate">KA-01-2201</span>
<div class="flex items-center gap-1 text-on-surface-variant">
<span class="material-symbols-outlined text-[14px] text-primary">navigation</span>
<span class="font-label-md text-[13px] text-tertiary truncate">En route to Sunrise Heart</span>
</div>
</div>
<span class="material-symbols-outlined text-outline">arrow_forward</span>
</div>
</div>
<!-- Reassuring Ergonomic Action Area -->
<div class="flex flex-col gap-space-xs mt-auto">
<button class="w-full h-16 min-h-[64px] bg-primary-container text-on-primary-container font-label-lg text-label-lg rounded-xl flex items-center justify-center gap-space-sm shadow-md active:opacity-90 active:scale-[0.99] transition-transform" id="ack-button" type="button">
<span class="material-symbols-outlined text-[24px]">task_alt</span>
<span>Acknowledge &amp; Return to Beds Dashboard</span>
</button>
<button class="w-full h-12 text-tertiary hover:text-on-surface font-label-md text-label-md rounded-lg flex items-center justify-center gap-1 active:bg-surface-variant/50 transition-colors" id="audit-button" type="button">
<span class="material-symbols-outlined text-[18px]">history</span>
<span>View Ward Audit Log</span>
</button>
</div>
</div>
<script>
  (function () {
    const ackBtn = document.getElementById('ack-button');
    const auditBtn = document.getElementById('audit-button');

    if (ackBtn) {
      ackBtn.addEventListener('click', function () {
        this.classList.add('opacity-75');
        const originalContent = this.innerHTML;
        this.innerHTML = '<span class="material-symbols-outlined animate-spin text-[24px]">progress_activity</span><span>Updating Ward Status...</span>';
        setTimeout(() => {
          this.innerHTML = '<span class="material-symbols-outlined text-[24px]">check_circle</span><span>Acknowledged</span>';
          setTimeout(() => {
            this.innerHTML = originalContent;
            this.classList.remove('opacity-75');
          }, 1200);
        }, 500);
      });
    }

    if (auditBtn) {
      auditBtn.addEventListener('click', function () {
        this.classList.toggle('text-primary');
      });
    }
  })();
</script></main></body></html>
