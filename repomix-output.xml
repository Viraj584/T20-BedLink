    if (json['lastUpdated'] != null) {
      if (json['lastUpdated'] is Timestamp) {
        updatedDate = (json['lastUpdated'] as Timestamp).toDate();
      } else if (json['lastUpdated'] is String) {
        updatedDate = DateTime.tryParse(json['lastUpdated']);
