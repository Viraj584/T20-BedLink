<script>
  (function initEmergencyAlert() {
    let secondsLeft = 107;
    const totalSeconds = 120;
    const countdownEl = document.getElementById('countdown-text');
    const strokeEl = document.getElementById('timer-stroke');
    const perimeter = 2 * Math.PI * 96; // ~603.18
    let muted = false;

    const timer = setInterval(() => {
      if (secondsLeft <= 0) {
        clearInterval(timer);
        if (countdownEl) countdownEl.textContent = '0:00';
        triggerAutoEscalation();
        return;
      }
      secondsLeft--;
      const mins = Math.floor(secondsLeft / 60);
      const secs = secondsLeft % 60;
      if (countdownEl) {
        countdownEl.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
      }
      if (strokeEl) {
        const offset = perimeter * (1 - (secondsLeft / totalSeconds));
        strokeEl.style.strokeDashoffset = offset;
      }
    }, 1000);

    const muteBtn = document.getElementById('mute-toggle-btn');
    const muteIcon = document.getElementById('mute-icon');
    if (muteBtn && muteIcon) {
      muteBtn.addEventListener('click', () => {
        muted = !muted;
        muteIcon.textContent = muted ? 'volume_off' : 'volume_up';
        showToast(muted ? 'Alarm muted for this terminal' : 'Audio alarm unmuted', muted ? 'volume_off' : 'volume_up');
      });
    }

    const acceptBtn = document.getElementById('accept-btn');
    const rejectBtn = document.getElementById('reject-btn');

    if (acceptBtn) {
      acceptBtn.addEventListener('click', () => {
        clearInterval(timer);
        showToast('Bed held successfully! Resus Bay 2 locked for Unit 402.', 'check_circle');
        acceptBtn.disabled = true;
        rejectBtn.disabled = true;
        acceptBtn.classList.add('opacity-75');
      });
    }

    if (rejectBtn) {
      rejectBtn.addEventListener('click', () => {
        clearInterval(timer);
        showToast('Request diverted to regional queue.', 'cancel');
        acceptBtn.disabled = true;
        rejectBtn.disabled = true;
        rejectBtn.classList.add('opacity-75');
      });
    }

    function triggerAutoEscalation() {
      showToast('No response: Escalating to Duty Medical Officer!', 'warning');
    }

    function showToast(message, iconName) {
      const toast = document.getElementById('status-toast');
      const msg = document.getElementById('toast-msg');
      const icon = document.getElementById('toast-icon');
      if (toast && msg && icon) {
        msg.textContent = message;
        icon.textContent = iconName;
        toast.classList.remove('hidden');
        setTimeout(() => {
          toast.classList.add('hidden');
        }, 3500);
      }
    }
  })();
</script></main></body></html>
