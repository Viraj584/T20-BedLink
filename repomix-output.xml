              const SizedBox(height: 16),
              Center(
                child: TextButton(
                  onPressed: () => context.push('/demo'),
                  child: const Text('Need seed data? Open Demo Controls'),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
