<script>
    (function initBedUpdater() {
      const tiles = document.querySelectorAll('.bed-tile');
      const erChips = document.querySelectorAll('.er-chip');
      const saveBtn = document.getElementById('save-update-btn');
      const confirmBtn = document.getElementById('confirm-all-btn');
      const timestampText = document.getElementById('update-timestamp-text');
      const totalIndicator = document.getElementById('total-available-indicator');

      let hasUnsavedChanges = false;

      function updateTotalCount() {
        let total = 0;
        document.querySelectorAll('.bed-count').forEach(el => {
          total += parseInt(el.textContent, 10) || 0;
        });
        if (totalIndicator) {
          totalIndicator.textContent = `${total} Free Beds`;
        }
      }

      function markDirty() {
        hasUnsavedChanges = true;
        saveBtn.disabled = false;
        saveBtn.classList.remove('opacity-50', 'cursor-not-allowed', 'bg-surface-container-high/60');
        saveBtn.classList.add('bg-surface-container-highest', 'text-on-surface', 'shadow-xs');
        saveBtn.querySelector('span:last-child').textContent = 'Commit Changes to Ambulance Grid';
      }

      tiles.forEach(tile => {
        const minusBtn = tile.querySelector('.btn-step-minus');
        const plusBtn = tile.querySelector('.btn-step-plus');
        const countSpan = tile.querySelector('.bed-count');
        const chip = tile.querySelector('.status-chip');
        const max = parseInt(tile.getAttribute('data-max'), 10) || 10;

        function refreshTileState(val) {
          countSpan.textContent = val;

          // Toggle minus state
          if (val <= 0) {
            minusBtn.disabled = true;
            minusBtn.classList.add('opacity-30', 'cursor-not-allowed');
            minusBtn.classList.remove('active:bg-secondary-container');
          } else {
            minusBtn.disabled = false;
            minusBtn.classList.remove('opacity-30', 'cursor-not-allowed');
            minusBtn.classList.add('active:bg-secondary-container');
          }

          // Toggle plus state
          if (val >= max) {
            plusBtn.disabled = true;
            plusBtn.classList.add('opacity-30', 'cursor-not-allowed');
          } else {
            plusBtn.disabled = false;
            plusBtn.classList.remove('opacity-30', 'cursor-not-allowed');
          }

          // Visual urgency themes
          if (val === 0) {
            tile.className = 'bed-tile relative flex flex-col justify-between bg-error-container/40 rounded-xl p-3 shadow-sm transition-all duration-150';
            countSpan.className = 'bed-count font-display-md text-display-md text-error font-bold leading-none tracking-tight';
            chip.className = 'status-chip text-[11px] font-label-md uppercase px-2 py-0.5 rounded-full font-bold bg-error text-on-error shadow-xs';
            chip.textContent = 'FULL';
          } else if (val <= 1) {
            tile.className = 'bed-tile relative flex flex-col justify-between bg-secondary-container/30 rounded-xl p-3 shadow-sm transition-all duration-150';
            countSpan.className = 'bed-count font-display-md text-display-md text-secondary font-bold leading-none tracking-tight';
            chip.className = 'status-chip text-[11px] font-label-md uppercase px-2 py-0.5 rounded-full font-bold bg-secondary text-on-secondary shadow-xs';
            chip.textContent = 'LOW';
          } else {
            tile.className = 'bed-tile relative flex flex-col justify-between bg-surface-container-lowest rounded-xl p-3 shadow-sm transition-all duration-150';
            countSpan.className = 'bed-count font-display-md text-display-md text-primary font-bold leading-none tracking-tight';
            chip.className = 'status-chip text-[11px] font-label-md uppercase px-1.5 py-0.5 rounded-full font-bold bg-secondary-container/50 text-on-secondary-container';
            chip.textContent = 'OPEN';
          }

          updateTotalCount();
        }

        minusBtn.addEventListener('click', (e) => {
          e.preventDefault();
          let current = parseInt(countSpan.textContent, 10);
          if (current > 0) {
            refreshTileState(current - 1);
            markDirty();
          }
        });

        plusBtn.addEventListener('click', (e) => {
          e.preventDefault();
          let current = parseInt(countSpan.textContent, 10);
          if (current < max) {
            refreshTileState(current + 1);
            markDirty();
          }
        });
      });

      // Segmented ER Load Radio Selector
      erChips.forEach(chip => {
        chip.addEventListener('click', () => {
          erChips.forEach(c => {
            c.setAttribute('aria-checked', 'false');
            c.className = 'er-chip h-14 rounded-xl flex items-center justify-center gap-1.5 px-2 bg-surface-container-low text-on-surface-variant font-title-lg text-title-lg active:bg-surface-container transition-all duration-150';
            const icon = c.querySelector('.material-symbols-outlined');
            if (icon) icon.className = 'material-symbols-outlined text-[20px] opacity-70';
          });

          chip.setAttribute('aria-checked', 'true');
          const loadType = chip.getAttribute('data-load');
          if (loadType === 'high') {
            chip.className = 'er-chip h-14 rounded-xl flex items-center justify-center gap-1.5 px-2 bg-error text-on-error font-title-lg text-title-lg shadow-sm transition-all duration-150';
          } else if (loadType === 'medium') {
            chip.className = 'er-chip h-14 rounded-xl flex items-center justify-center gap-1.5 px-2 bg-secondary text-on-secondary font-title-lg text-title-lg shadow-sm transition-all duration-150';
          } else {
            chip.className = 'er-chip h-14 rounded-xl flex items-center justify-center gap-1.5 px-2 bg-primary text-on-primary font-title-lg text-title-lg shadow-sm transition-all duration-150';
          }
          const activeIcon = chip.querySelector('.material-symbols-outlined');
          if (activeIcon) activeIcon.className = 'material-symbols-outlined text-[20px]';

          markDirty();
        });
      });

      function flashSuccessFeedback(button, originalText, successText) {
        button.innerHTML = `<span class="material-symbols-outlined text-[22px]">check</span><span>${successText}</span>`;
        button.classList.add('bg-primary');
        timestampText.textContent = 'Last updated just now';

        setTimeout(() => {
          button.innerHTML = originalText;
          button.classList.remove('bg-primary');
          hasUnsavedChanges = false;
          saveBtn.disabled = true;
          saveBtn.className = 'h-12 w-full rounded-xl bg-surface-container-high/60 text-on-surface-variant opacity-50 cursor-not-allowed font-title-lg text-label-lg flex items-center justify-center gap-2 transition-all';
          saveBtn.querySelector('span:last-child').textContent = 'Stage Bed Audit Log';
        }, 1800);
      }

      confirmBtn.addEventListener('click', () => {
        flashSuccessFeedback(confirmBtn, `<span class="material-symbols-outlined text-[26px]">verified</span><span>Everything is up to date</span>`, 'Verified & Synced!');
      });

      saveBtn.addEventListener('click', () => {
        if (!saveBtn.disabled) {
          flashSuccessFeedback(saveBtn, `<span class="material-symbols-outlined text-[18px]">cloud_sync</span><span>Stage Bed Audit Log</span>`, 'Dispatched to Dispatch En Route');
        }
      });

      updateTotalCount();
    })();
  </script>
</div></main><nav class="fixed bottom-0 w-full z-50 pb-safe bg-surface-container-lowest/95 backdrop-blur-xl shadow-[0_-2px_12px_rgba(10,30,35,0.08)]" data-active-classes="text-primary font-bold bg-secondary-container/40"><div class="grid grid-cols-2 items-center h-20 px-space-sm gap-space-sm"><a aria-current="page" class="flex flex-col items-center justify-center h-14 rounded-xl transition-colors text-primary font-bold bg-secondary-container/40" data-path="bed-inventory" href="#"><span class="material-symbols-outlined text-[26px]">bed</span><span class="font-label-md text-label-md mt-space-xs">Beds</span></a><a class="relative flex flex-col items-center justify-center h-14 rounded-xl text-on-surface-variant hover:text-on-surface transition-colors" data-path="incoming-requests" href="#"><div class="relative flex items-center justify-center"><span class="material-symbols-outlined text-[26px]">notifications</span><span class="absolute -top-1 -right-2 min-w-[20px] h-[20px] px-1 bg-error text-on-error font-label-md text-[11px] leading-[20px] text-center rounded-full font-bold shadow-sm">1</span></div><span class="font-label-md text-label-md mt-space-xs">Requests</span></a></div></nav></body></html>
